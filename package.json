{
  "name": "t3-maple-adapter",
  "version": "0.1.0",
  "description": "Export finished T3 Code turns to Maple Agent Sessions as OpenTelemetry GenAI spans",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tino-software/t3-maple-adapter.git"
  },
  "type": "module",
  "module": "src/main.ts",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "check": "bun test && tsc --noEmit -p .",
    "watch": "bun src/main.ts watch",
    "backfill": "bun src/main.ts backfill"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/otlp-transformer": "0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
