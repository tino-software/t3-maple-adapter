# Copy to .env (git-ignored) or export in your shell / LaunchAgent.
# By default the adapter reads the OTLP URL and headers from ~/.t3/userdata/otel.env,
# the file T3 Code already uses for its own telemetry. Set these only to override it.

# T3_MAPLE_TRACES_URL=https://<your-maple-ingest-host>/v1/traces
# T3_MAPLE_OTLP_HEADERS=Authorization=Bearer%20<your-maple-ingest-key>

# Resource attributes on every exported span.
# T3_MAPLE_HOST=my-laptop                     # host.name (default: os.hostname())
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=laptop   # default: unknown

# Privacy
# T3_MAPLE_CAPTURE_CONTENT=0                  # drop prompts, replies and tool I/O (default: 1)
# T3_MAPLE_MAX_CONTENT_CHARS=16000
# T3_MAPLE_EXCLUDE_PROJECTS=client-project,0000aaaa-1111-2222-3333-444455556666

# Paths and polling
# T3_HOME=~/.t3/userdata
# T3_MAPLE_DB=~/.t3/userdata/statev2.sqlite
# T3_MAPLE_OTEL_ENV=~/.t3/userdata/otel.env
# T3_MAPLE_STATE=~/.local/state/t3-maple-adapter/state.json
# T3_MAPLE_POLL_MS=5000
